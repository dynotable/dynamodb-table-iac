{
  "name": "dynamodb-table-iac",
  "version": "0.1.1",
  "description": "Export a DynamoDB table definition (DescribeTable JSON) as runnable infrastructure code: Terraform (aws_dynamodb_table), AWS CDK (TableV2) or CloudFormation (AWS::DynamoDB::GlobalTable), global-table replicas included. Zero dependencies.",
  "keywords": [
    "dynamodb",
    "terraform",
    "cdk",
    "aws-cdk",
    "cloudformation",
    "iac",
    "infrastructure-as-code",
    "describe-table",
    "global-tables",
    "code-generator",
    "codegen",
    "aws"
  ],
  "license": "MIT",
  "author": "DynoTable <support@dynotable.com> (https://dynotable.com)",
  "homepage": "https://dynotable.com/tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dynotable/dynamodb-table-iac.git"
  },
  "bugs": {
    "url": "https://github.com/dynotable/dynamodb-table-iac/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint src tests scripts",
    "typecheck": "tsc --noEmit",
    "check:package": "publint && attw --pack .",
    "validate:terraform": "node scripts/validate-terraform.ts",
    "validate:cdk": "node scripts/validate-cdk.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^26.2.0",
    "oxlint": "^1.35.0",
    "publint": "^0.3.14",
    "tsdown": "^0.15.7",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0",
    "yaml": "^2.9.1"
  }
}
